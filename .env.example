# Настройки службы трекера, префикс TT_. Секретов нет: служба без аутентификации (README.md, «Безопасность»).
# Комментарии отдельными строками: docker --env-file читает хвост строки как часть значения.

# Каталог задач: <id>.md, проект - поле задачи. В контейнере - /data (том).
TT_DATA_DIR=data
# Внешний адрес службы для ссылок на задачу в ответах, например http://localhost:8113. Пусто - ссылки относительные.
TT_PUBLIC_URL=
# 1 - каждая запись коммитится в git каталога данных; 0 - без истории.
TT_GIT=1
# Адрес, который слушает служба: 127.0.0.1 - только эта машина, 0.0.0.0 - вся сеть. В образе - 0.0.0.0.
TT_HOST=127.0.0.1
TT_PORT=8113
